{
  "crons": [
    { "path": "/api/payment-reminders", "schedule": "0 13 * * *" },
    { "path": "/api/weekly-digest", "schedule": "0 13 * * 1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
